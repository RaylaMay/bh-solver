+def _handle_index(handle: str | None, prefix: str) -> int:
+    if handle is None:
+        return 0
+    match = re.fullmatch(rf"{prefix}-(\d+)", handle)
+    if match is None:
+        raise ValueError(f"invalid {prefix} handle: {handle!r}")
+    return int(match.group(1))
