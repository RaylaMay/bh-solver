+
+def test_corrupt_dock_state_does_not_apply_partial_geometry(window: WorkstationWindow) -> None:
+    settings = window.workspace.settings
+    settings.setValue("layout/version", LAYOUT_VERSION)
+    window.resize(1200, 760)
